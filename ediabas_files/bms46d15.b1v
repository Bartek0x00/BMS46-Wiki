LINE "0x42", "Fehler bei Ram-Test"
LINE "0x52", "Unerlaubter System-Reset"
LINE "0x62", "KS. Masse / Fehler E-Luefter"
LINE "0x72", "KS. Masse oder Unterbrechung"
LINE "0x82", "KW-Signal nicht erkennbar"
LINE "0x92", "Timeout"
LINE "0xA2", "DME hat noch keinen Urcode"
LINE "0xB2", "Fehler beim Loeschen"
LINE "0x13", "Leitungsunterbrechung"
LINE "0x23", "kein primaerer Flyback"
LINE "0x33", "Leitungsunterbr. oder Uebertemp."
LINE "0x43", "Unterbrechung QSPI"
LINE "0x53", "Watchdog-Reset"
LINE "0x63", "Unterbr. oder Kurzschluss Masse"
LINE "0x73", "Wechselcode ungueltig"
LINE "0x14", "Unplausibel"
LINE "0x24", "Uebertemperatur"
LINE "0x34", "Nockenwelle nicht erkennbar"
LINE "0x44", "Kurbelwellensignal gestoert"
LINE "0x54", "Kein sekundaerer Flyback"
LINE "0x64", "Fehler Eprom-Emulation"
LINE "0x74", "KS_P,KS_M,Unterbr oder Uebertemp"
LINE "0x84", "Parity-Fehler"
LINE "0x94", "Drehzahl unplausibel"
LINE "0xA4", "Klopfbaustein defekt"
LINE "0xB4", "CRC-Fehler"
LINE "0x15", "SG-spezifische Bedeutung"
LINE "0x16", "Fehler in Filterung"
LINE "0x17", "Fehler momentan vorhanden"
LINE "0x07", "Fehler momentan nicht vorh."
LINE "0x18", "Fehler gilt als sporadisch"
LINE "0xXY", "- falsche Fehlerart -"
TEND

TBEG "FUMWELTTEXTE"
HEAD "UWNR", "UWTEXT", "UW_EINH", "UWF_A", "UWF_B", "UWF_C"
LINE "0x00", "NULL", "--", "1", "0", "1"
LINE "0x01", "Motordrehzahl", "1/min", "40", "0", "1"
LINE "0x02", "Motortemperatur", "Grad C", "0.75", "48", "1"
LINE "0x03", "Ansauglufttemperatur", "Grad C", "0.75", "48", "1"
LINE "0x04", "Wahre Regelgroesse Last", "mg/AS/Z", "3", "0", "1"
LINE "0x05", "Batteriespannung", "V", "9.48", "0", "100"
LINE "0x06", "Geschwindigkeit", "km/h", "1", "0", "1"
LINE "0x07", "Drosselpotispg", "V", "1,960", "0", "100"
LINE "0x08", "Lambdasondenspannung", "V", "1.25", "0", "256"
LINE "0x09", "Reset-Status-Register", "1", "1", "0", "1"
LINE "0x0A", "NULL", "--", "1", "0", "1"
LINE "0x0B", "Spannung an Klemme 15", "V", "9.48", "0", "100"
LINE "0xXY", "unbekannte Umweltbedingung", "--", "1", "0", "1"
TEND

TBEG "JOBRESULT"
HEAD "SB", "STATUS_TEXT"
LINE "0xA0", "OKAY"
LINE "0xA1", "BUSY"
LINE "0xA2", "ERROR_ECU_REJECTED"
LINE "0xB0", "ERROR_ECU_PARAMETER"
LINE "0xB1", "ERROR_ECU_FUNCTION"
LINE "0xB2", "ERROR_ECU_NUMBER"
LINE "0xFF", "ERROR_ECU_NACK"
LINE "0x00", "ERROR_ECU_UNKNOWN_STATUSBYTE"
TEND


